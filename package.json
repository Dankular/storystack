{
  "name": "storystack",
  "version": "1.0.0",
  "private": true,
  "description": "A modern story hosting platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @storystack/api",
    "dev:web": "npm run dev -w @storystack/web",
    "build": "npm run build -w @storystack/api && npm run build -w @storystack/web",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:api": "npm run start -w @storystack/api",
    "start:web": "npm run start -w @storystack/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
